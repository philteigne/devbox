# Destination: app/app.env
#
# This file contains public GitHub App identifiers, so the completed app.env may
# be committed. The private key is separate: place exactly one GitHub App *.pem
# file in app/. PEM files are secret and are ignored by Git.

# Required. Numeric GitHub App ID from the App's settings page.
APP_ID=123456

# Optional public OAuth client ID. Devbox records it but currently authenticates
# the App using APP_ID and the private key.
CLIENT_ID=Iv23exampleClientId

# Optional. `devbox init` fetches and fills this when it is empty.
APP_SLUG=

# Optional. `devbox init` derives both bot identity values when they are empty.
GIT_USER_NAME=
GIT_USER_EMAIL=
