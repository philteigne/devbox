# Destination: secrets/gh.env
#
# Optional. This token is used by `devbox init` only when it needs to add a
# repository to a GitHub App installation configured for selected repositories.
# Without it, Devbox prints a URL so the repository can be added manually.
#
# Use a classic personal access token with `repo` scope. The real file is ignored
# by Git. Prefer DEVBOX_PAT; GITHUB_TOKEN and GH_TOKEN are accepted aliases.

DEVBOX_PAT=

# Alternative spellings (leave commented unless needed):
# GITHUB_TOKEN=
# GH_TOKEN=
#
# A DEVBOX_PAT environment variable in the host process takes precedence over
# values in this file.
