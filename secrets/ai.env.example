# Destination: secrets/ai.env
#
# Add only the variables required by the AI tooling you use. Devbox accepts any
# NAME=value entry and injects every non-empty value into the target container.
# This real file is ignored by Git; never put working credentials in this example.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# OpenCode Zen gateway (use the variable name expected by your OpenCode setup).
OPENCODE_API_KEY=
OPENCODE_ZEN_API_KEY=

# Optional non-secret preference kept here because it is passed to the same
# container process. Example: opencode/provider-model-name
OPENCODE_MODEL=

# You may add other provider variables, for example:
# OTHER_PROVIDER_API_KEY=
#
# Empty values are not injected. Non-empty values override variables with the
# same names from Devbox built-ins or the target's launch configuration.
