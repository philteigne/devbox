# Generated destination: config/<owner>/<repo>/config.env
#
# Do not copy this file as-is. Run:
#   python -m devbox init <path-to-target-repository>
#
# Devbox queries GitHub and writes all seven required, non-secret values. The
# generated file may be committed with this devbox repository.

# GitHub owner and repository name. These must match the target's Git remote.
OWNER=example-owner
REPO=example-repository

# Numeric IDs returned by GitHub.
REPO_ID=123456789
INSTALLATION_ID=987654321

# Default branch name returned by GitHub.
DEFAULT_BRANCH=main

# Allowed values: enforced or unavailable.
BRANCH_PROTECTION=enforced

# Allowed values: granted or missing.
APP_REPO_ACCESS=granted

# PR mode requires both BRANCH_PROTECTION=enforced and APP_REPO_ACCESS=granted.
# Devbox falls back to NO-PR mode when either safety condition is not satisfied.
